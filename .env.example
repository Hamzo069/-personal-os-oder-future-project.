# ---------------------------------------------------------------------------
# LedgerLens API configuration
# Copy to apps/api/.env (or export as environment variables). Never commit .env.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# REQUIRED in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development a random key is generated on every start if this is empty.
SECRET_KEY=

# Access tokens are short-lived JWTs; refresh tokens live in an httpOnly cookie.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Set to true when served over HTTPS (defaults to true in production).
# COOKIE_SECURE=true

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute per IP (auth endpoints) / per user (AI endpoints).
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# SQLite for local development; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://ledgerlens:ledgerlens@localhost:5432/ledgerlens
DATABASE_URL=sqlite:///./data/ledgerlens.db
# Supabase (use the Session pooler string from Connect; URL-encode special characters in the
# password; see docs/08-deployment.md):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Uploaded receipts are stored here (relative to apps/api).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# mock      -> no API key needed, deterministic demo extraction (default)
# anthropic -> real receipt extraction and natural-language queries with Claude
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# claude-opus-5 gives the best extraction quality. claude-sonnet-5 is a cheaper
# alternative for high-volume receipt processing.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high - controls how much the model "thinks" per request (cost/quality).
ANTHROPIC_EFFORT=medium
AI_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Docker Compose / hosting (read from .env in the repository root)
# ---------------------------------------------------------------------------
# Password of the PostgreSQL container. On a server use a random value with letters and
# digits only (it becomes part of the database URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Public host name for `docker compose --profile https up -d`. Caddy requests the
# HTTPS certificate for it automatically. Also set CORS_ORIGINS=https://<DOMAIN>
# and COOKIE_SECURE=true.
# DOMAIN=ledger.example.com
